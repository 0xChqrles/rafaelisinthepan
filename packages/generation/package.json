{
  "name": "@whippin/generation",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "reduce:en": "uv run scripts/reduce_embedding.py embedding/en/cc.en.300.vec --lang en",
    "reduce:fr": "uv run scripts/reduce_embedding.py embedding/fr/cc.fr.300.vec --lang fr",
    "wordlist:en": "uv run scripts/build_wordlist.py --lang en",
    "wordlist:fr": "uv run scripts/build_wordlist.py --lang fr",
    "forms:fr": "uv run scripts/build_forms.py --lang fr",
    "forms:en": "uv run scripts/build_forms.py --lang en",
    "vocab:en": "uv run scripts/build_vocab.py --lang en",
    "vocab:fr": "uv run scripts/build_vocab.py --lang fr",
    "gen:phrase": "uv run scripts/gen_phrase.py",
    "gen:word": "uv run scripts/gen_word.py",
    "test": "uv run --no-project --with pytest pytest -q tests"
  }
}
