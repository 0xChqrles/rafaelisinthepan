# Base URL of the daily-puzzle backend (Lambda Function URL behind CloudFront, #2).
# The server is the authoritative time source and serves "today's" puzzle.
#
# For LOCAL DEV: copy this to `.env.local` (gitignored) and point it at your backend.
# Local backend harness (#17): run `pnpm backend:dev` and point this at it, then
# `pnpm dev` resolves today's puzzle end-to-end (no ?puzzle= override needed):
#   VITE_API_BASE_URL=http://localhost:8787
#
# For PRODUCTION BUILD (`pnpm build`): no need to set anything here — the committed
# `.env.production` already holds the deployed backend URL (BackendStack `ApiUrl`,
# https://api.whippin.ai) and takes precedence over `.env.local` in production mode.
#
# Required for dev/build. The frontend must not silently use its own origin as the backend.
VITE_API_BASE_URL=http://localhost:8787

# Privacy-first analytics (Plausible, #60) is configured for PRODUCTION builds in the
# committed .env.production (VITE_PLAUSIBLE_DOMAIN=whippin.ai) — the domain is public, so
# it lives in committed config, not a secret. You do NOT need it for local dev: `pnpm dev`
# never loads .env.production, so analytics stays inert here (and Plausible self-suppresses
# on localhost). Set it below only to test analytics against a real Plausible site locally.
# VITE_PLAUSIBLE_DOMAIN=whippin.ai
