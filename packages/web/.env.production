# Production build config (loaded by `vite build`, i.e. `pnpm build`).
# Committed on purpose: VITE_* vars are PUBLIC (baked into the shipped bundle), so this
# is the reproducible prod value — no need to pass VITE_API_BASE_URL on the command line.
#
# Points at the deployed backend's stable custom domain (BackendStack `ApiUrl`, #3/#21).
# `.env.production` takes precedence over the gitignored `.env.local` (localhost) in
# production mode, so local dev (`pnpm dev`) still uses `.env.local`.
VITE_API_BASE_URL=https://api.whippin.ai

# Privacy-first analytics (Plausible, #60). The domain identifies the site to Plausible;
# it is PUBLIC (it ships in the bundle regardless), so it lives here in committed config —
# no secret, no repo variable. Committed here means EVERY production build reports, whether
# deployed by CI or by `pnpm build` from a laptop. Dev is unaffected: `pnpm dev`
# (development mode) never loads `.env.production`, and Plausible's script self-suppresses
# on localhost, so even a local `pnpm preview` of a prod build sends nothing.
VITE_PLAUSIBLE_DOMAIN=whippin.ai
