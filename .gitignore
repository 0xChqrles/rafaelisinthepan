# ── Node / Vite ──────────────────────────────────────────────
node_modules
dist
dist-ssr
*.local
.DS_Store
.env
.env.*
!.env.example
# Committed: holds only PUBLIC VITE_* build config (no secrets) so prod builds are reproducible.
!.env.production

# ── Python / uv ──────────────────────────────────────────────
.venv
__pycache__
*.pyc
.pytest_cache

# ── WhatsApp bot group configs (#236) ────────────────────────
# SSM is the source of truth (`/whippin/bot/groups/<slug>`); this directory is a SNAPSHOT
# pulled from it before a build or a deploy. A group JID names a real private conversation
# and this repo is public, so the snapshot is never committed — `groups/example.json` is.
packages/whatsapp-bot/groups/local/*.json

# ── Editor / tooling local state ─────────────────────────────
.claude/settings.local.json

# ── CDK (issue #3) synth output ──────────────────────────────
cdk.out
packages/infra/cdk.out

# ── Local backend puzzle store (issue #17) ───────────────────
# Puzzles published locally for `pnpm backend:dev`; regenerate/republish at will.
.local-store
packages/backend/.local-store

# ── Generation output (puzzles staged for publish) ───────────
# `pnpm gen:phrase` writes puzzles here; publish them to the store/S3 with
# `pnpm puzzle:publish`. Regenerable artifacts — not tracked. (vocab/<lang>.json
# is a web asset and stays under packages/web/public/vocab.)
packages/generation/output

# ── Curation shelf + run logs (issue #260) ───────────────────
# The shelf holds the epubs to mine (copyrighted) and index.json (which books were
# read, which sentences were proposed); runs/ holds one log per run. Never committed.
packages/curation/shelf
packages/curation/runs

# ── Offline benchmark lab output (issue #80) ─────────────────
# Full paid-run session records (transcripts, transport, timing, token usage) stay
# local: the harness is lab-only and never writes into a puzzle file.
packages/benchmark/output

# ── Embeddings (all excluded — too large for GitHub) ─────────
# Raw sources are multi-GB; even the *_reduced files are 400-500 MB each,
# over GitHub's 100 MB hard limit. Regenerate locally with
# `pnpm reduce:<lang>`, which also rebuilds the .kv caches.
*.vec
*.bin
packages/generation/embedding/**/*.txt
*.kv
*.kv.vectors.npy
*.npy

# ── Wordlist build cache (issue #38) ─────────────────────────
# Raw source downloads for `pnpm wordlist:<lang>` (Lexique/SCOWL/Hunspell). Re-fetched
# on demand; the committed wordlist/<lang>.txt.gz is the versioned build output.
packages/generation/wordlist/.cache
